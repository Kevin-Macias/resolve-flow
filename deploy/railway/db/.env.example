# Paste into the Railway service named db. This is not a shell script.
POSTGRES_DB=resolve_flow
POSTGRES_USER=resolve_flow
# Replace in Railway with a generated, long alphanumeric password.
POSTGRES_PASSWORD=REPLACE_IN_RAILWAY
PGDATA=/var/lib/postgresql/data/pgdata
DATABASE_URL=postgresql://${{db.POSTGRES_USER}}:${{db.POSTGRES_PASSWORD}}@${{db.RAILWAY_PRIVATE_DOMAIN}}:5432/${{db.POSTGRES_DB}}
