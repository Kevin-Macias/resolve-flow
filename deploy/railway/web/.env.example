# Paste into the Railway service named web. This is not a shell script.
RAILWAY_DOCKERFILE_PATH=apps/web/Dockerfile
# Runtime settings. Use the API public HTTPS origin for the initial rollout.
API_ORIGIN=https://REPLACE-API-DOMAIN
WEB_ORIGIN=https://REPLACE-WEB-DOMAIN
VITE_AUTH_MODE=password
# Optional public address for the Request an invitation link.
VITE_INVITATION_EMAIL=
