# Paste into the Railway service named api. This is not a shell script.
RAILWAY_DOCKERFILE_PATH=apps/api/Dockerfile
DATABASE_URL=${{db.DATABASE_URL}}
AUTH_MODE=password
INTAKE_PROVIDER_MODE=offline
EVIDENCE_PROVIDER_MODE=offline
# Replace with the generated HTTPS web origin, without a trailing slash.
CORS_ORIGINS=https://REPLACE-WEB-DOMAIN
REQUEST_LIMITS={}
