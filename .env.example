POSTGRES_DB=resolve_flow
POSTGRES_USER=resolve_flow
POSTGRES_PASSWORD=resolve_flow_local
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
VITE_API_URL=http://localhost:8000

# Map a local demo token to an existing customer User UUID; never use production credentials.
DEMO_TOKEN_USER_IDS={}

# Support User UUID -> allowed CustomerAccount UUID array. Missing grants deny access.
DEMO_SUPPORT_ACCOUNT_IDS={}

# Host-side migrations and pnpm setup:checkpoints (Docker supplies its own URL)
DATABASE_URL=postgresql://resolve_flow:resolve_flow_local@localhost:5432/resolve_flow

# Intake defaults to an explicitly labeled offline script. Live mode is opt-in.
INTAKE_PROVIDER_MODE=offline

# Preliminary support evidence uses fixture ranking and scripted analysis by default.
EVIDENCE_PROVIDER_MODE=offline
# Required only for an explicit live support analysis; corpus must be indexed first.
EVIDENCE_OPENAI_MODEL=
# Optional repository root containing knowledge/manifest.json (required in Docker).
KNOWLEDGE_ROOT=

# Optional: required for pnpm test:live or INTAKE_PROVIDER_MODE=live
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
