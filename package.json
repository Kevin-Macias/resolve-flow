{
  "name": "resolve-flow",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm --filter @resolve-flow/web dev\"",
    "dev:api": "uv run --directory apps/api python -m api.server --reload --host 127.0.0.1",
    "setup": "uv sync --directory apps/api",
    "generate:api-client": "uv run --directory apps/api python scripts/export_openapi.py && pnpm --filter @resolve-flow/api-client generate",
    "check:api-client": "uv run --directory apps/api python scripts/export_openapi.py --check && pnpm --filter @resolve-flow/api-client check:generated",
    "build": "pnpm --filter @resolve-flow/web build",
    "test": "uv run --directory apps/api pytest",
    "test:live": "uv run --directory apps/api --env-file ../../.env python scripts/live_extraction_check.py",
    "setup:checkpoints": "uv run --directory apps/api --env-file ../../.env python scripts/setup_workflow_checkpoints.py",
    "format": "uv run --directory apps/api ruff format .",
    "format:check": "uv run --directory apps/api ruff format --check .",
    "fix": "pnpm format && uv run --directory apps/api ruff check --fix .",
    "lint": "uv run --directory apps/api ruff check .",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api && pnpm typecheck:api-client",
    "typecheck:api": "uv run --directory apps/api pyright",
    "typecheck:api-client": "pnpm --filter @resolve-flow/api-client typecheck",
    "typecheck:web": "pnpm --filter @resolve-flow/web typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm check:api-client && pnpm typecheck && pnpm test && pnpm test:web",
    "docker:up": "docker compose up --build",
    "docker:smoke": "python3 apps/api/scripts/smoke_containers.py",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow",
    "test:web": "pnpm --filter @resolve-flow/web test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
